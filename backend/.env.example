# Copy to .env and set a fresh server-side OpenRouter credential.
# Never commit .env or put this value in the iOS client.
OPENROUTER_API_KEY=
PORT=4000

# Required for API access; 32-128 URL-safe characters, never commit a real value.
VEGANIFY_API_TOKEN=
# Loopback by default. Use a TLS reverse proxy for remote/device access.
HOST=127.0.0.1
